{
  "name": "upserve-workspace",
  "private": true,
  "homepage": "https://upserve.neplex.dev",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint packages tests examples scripts apps/playground",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docs:build": "pnpm --filter @upserve/docs build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "check": "pnpm check:code && pnpm docs:build",
    "check:code": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "hono": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.32.1"
}
